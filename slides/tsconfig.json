{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node"]
    },
    "include": ["src", "server", "scripts", "test"]
}
