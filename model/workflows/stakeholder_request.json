{
  "name": "wf-e3-stakeholder_request",
  "label": "Solicitud",
  "enabled": true,
  "definition": {
    "states": [
      { "name": "received", "label": "Recibida", "type": "INITIAL" },
      { "name": "under_evaluation", "label": "En evaluación", "type": "INTERMEDIATE" },
      { "name": "accepted", "label": "Aceptada", "type": "INTERMEDIATE" },
      { "name": "declined", "label": "Declinada", "type": "INTERMEDIATE" },
      { "name": "closed", "label": "Cerrada", "type": "FINAL" }
    ],
    "transitions": [
      { "name": "start_evaluation", "label": "Evaluar", "from": "received", "to": "under_evaluation",
        "roles": ["GRIEVANCE_MANAGER", "SOCIAL_MANAGER"] },
      { "name": "accept", "label": "Aceptar", "from": "under_evaluation", "to": "accepted",
        "roles": ["SOCIAL_MANAGER", "COMMITMENT_MANAGER"] },
      { "name": "decline", "label": "Declinar", "from": "under_evaluation", "to": "declined",
        "roles": ["GRIEVANCE_MANAGER", "SOCIAL_MANAGER"] },
      { "name": "close_declined", "label": "Cerrar", "from": "declined", "to": "closed",
        "roles": ["GRIEVANCE_MANAGER", "SOCIAL_MANAGER"] },
      { "name": "close_accepted", "label": "Cerrar por cierre del compromiso o del aporte", "from": "accepted", "to": "closed",
        "roles": ["COMMITMENT_MANAGER", "SOCIAL_MANAGER"] },
      { "name": "close_unfulfilled", "label": "Cerrar sin ejecución", "from": "accepted", "to": "closed",
        "roles": ["GRIEVANCE_MANAGER", "SOCIAL_MANAGER"] },
      { "name": "close_reclassified_received", "label": "Cerrar por reclasificación", "from": "received", "to": "closed",
        "roles": ["GRIEVANCE_MANAGER"] },
      { "name": "close_reclassified_under_evaluation", "label": "Cerrar por reclasificación", "from": "under_evaluation", "to": "closed",
        "roles": ["GRIEVANCE_MANAGER"] }
    ]
  }
}
