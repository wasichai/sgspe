{
  "name": "wf-g-social_program",
  "label": "Programa social",
  "enabled": true,
  "definition": {
    "states": [
      { "name": "draft", "label": "Borrador", "type": "INITIAL" },
      { "name": "pending_approval", "label": "Pendiente de aprobación", "type": "INTERMEDIATE" },
      { "name": "planned", "label": "Planificado", "type": "INTERMEDIATE" },
      { "name": "executing", "label": "En ejecución", "type": "INTERMEDIATE" },
      { "name": "monitoring", "label": "En monitoreo", "type": "INTERMEDIATE" },
      { "name": "evaluation", "label": "En evaluación", "type": "INTERMEDIATE" },
      { "name": "suspended", "label": "Suspendido", "type": "INTERMEDIATE" },
      { "name": "closed", "label": "Cerrado", "type": "FINAL" },
      { "name": "cancelled", "label": "Cancelado", "type": "FINAL" }
    ],
    "transitions": [
      { "name": "submit", "label": "Enviar a aprobación", "from": "draft", "to": "pending_approval",
        "roles": ["SOCIAL_INVESTMENT_MANAGER"] },
      { "name": "return_to_draft", "label": "Devolver", "from": "pending_approval", "to": "draft",
        "roles": ["APPROVER"] },
      { "name": "approve", "label": "Aprobar", "from": "pending_approval", "to": "planned",
        "roles": ["APPROVER"] },
      { "name": "plan_direct", "label": "Planificar sin aprobación interna", "from": "draft", "to": "planned",
        "roles": ["SOCIAL_INVESTMENT_MANAGER"] },
      { "name": "start_execution", "label": "Iniciar ejecución", "from": "planned", "to": "executing",
        "roles": ["SOCIAL_INVESTMENT_MANAGER"] },
      { "name": "start_monitoring", "label": "Pasar a monitoreo", "from": "executing", "to": "monitoring",
        "roles": ["SOCIAL_INVESTMENT_MANAGER"] },
      { "name": "start_evaluation", "label": "Evaluar", "from": "monitoring", "to": "evaluation",
        "roles": ["SOCIAL_INVESTMENT_MANAGER", "SOCIAL_MANAGER"] },
      { "name": "close", "label": "Cerrar", "from": "evaluation", "to": "closed",
        "roles": ["SOCIAL_MANAGER"] },
      { "name": "suspend", "label": "Suspender", "from": "executing", "to": "suspended",
        "roles": ["SOCIAL_MANAGER", "APPROVER"] },
      { "name": "resume", "label": "Reanudar", "from": "suspended", "to": "executing",
        "roles": ["SOCIAL_MANAGER", "APPROVER"] },
      { "name": "cancel_draft", "label": "Cancelar", "from": "draft", "to": "cancelled",
        "roles": ["SOCIAL_INVESTMENT_MANAGER", "SOCIAL_MANAGER", "APPROVER"] },
      { "name": "cancel_pending_approval", "label": "Cancelar", "from": "pending_approval", "to": "cancelled",
        "roles": ["SOCIAL_MANAGER", "APPROVER"] },
      { "name": "cancel_planned", "label": "Cancelar", "from": "planned", "to": "cancelled",
        "roles": ["SOCIAL_MANAGER", "APPROVER"] },
      { "name": "cancel_suspended", "label": "Cancelar", "from": "suspended", "to": "cancelled",
        "roles": ["SOCIAL_MANAGER", "APPROVER"] }
    ]
  }
}
