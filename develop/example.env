# Variables de ejemplo para desarrollar sgspe en local (adaptado de caja-backend).
#
#   cp develop/example.env develop/.env      # develop/.env está en .gitignore: nunca se versiona
#   set -a; source develop/.env; set +a      # exporta las variables al shell actual
#   GITHUB_ACTOR=$(gh api user -q .login) GITHUB_TOKEN=$(gh auth token) ./gradlew bootRun
#
# El token de GitHub Packages nunca va en este archivo. Guía completa: docs/develop/README.md

# --- Base de datos (compose.yml: postgis/postgis:18-3.6 en 127.0.0.1:5435 del VPS, por túnel ssh) ---
WASICHAI_DB_HOST=localhost
WASICHAI_DB_PORT=5435
WASICHAI_DB_NAME=sgspe
WASICHAI_DB_USERNAME=sgspe
WASICHAI_DB_PASSWORD=sgspe
# puerto que publica compose.yml (debe coincidir con WASICHAI_DB_PORT)
SGSPE_PG_PORT=5435

# --- Seguridad (solo desarrollo) ---
# >= 32 bytes. en cualquier entorno real, uno propio y secreto (application-prod.yml lo exige)
WASICHAI_JWT_SECRET=sgspe-dev-only-secret-change-me-0123456789
# crea admin@wasichai.local / admin. apagarlo (false) fuera de desarrollo. una variable de entorno gana a application-prod.yml:
# con el perfil prod, WASICHAI_SEED_DEV=true hace fallar el arranque (ProdGuard)
WASICHAI_SEED_DEV=true

# --- Evidencias (F3, ADR-0014): el campo FILE de wasichai-files ---
# local (por defecto) guarda en WASICHAI_FILES_LOCAL_PATH; s3 usa el MinIO de compose.yml por el túnel del puerto 9095
# (docker compose up -d minio minio-init crea el bucket sgspe-evidencias; consola en http://localhost:9096)
# WASICHAI_FILES_STORE=s3
# WASICHAI_FILES_S3_BUCKET=sgspe-evidencias
# WASICHAI_FILES_S3_ENDPOINT=http://localhost:9095
# WASICHAI_FILES_S3_ACCESS_KEY=sgspe
# WASICHAI_FILES_S3_SECRET_KEY=sgspe-minio
# puertos que publica compose.yml
SGSPE_MINIO_PORT=9095
SGSPE_MINIO_CONSOLE_PORT=9096

# --- IA (F7, ASM-128): las organizaciones con la IA activada, por su slug. la clave del proveedor (ANTHROPIC_API_KEY) nunca va
# en este archivo: se exporta en el shell, a mano, solo cuando se prueba con el proveedor real ---
# SGSPE_AI_ENABLED_ORGANIZATIONS=demo

# --- Correo de las notificaciones (F3, GAP-021): Mailpit de compose.yml por el túnel del puerto 1029 ---
# (interfaz web en http://localhost:8029)
# WASICHAI_NOTIFICATIONS_EMAIL_ENABLED=true
# WASICHAI_NOTIFICATIONS_EMAIL_FROM=avisos@sgspe.test
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1029
SGSPE_SMTP_PORT=1029
SGSPE_MAILPIT_PORT=8029

# --- GeoServer (F6, ADR-0015): compose.yml lo publica en 127.0.0.1:8095 del VPS, por túnel (ssh -fN -L 8095:localhost:8095) ---
# apagado, /api/gis/layers lista las capas con published=false. encendido, model/publish_layers.py publica las capas públicas
# y carga los estilos con estas mismas variables (nunca por argumento). docker compose up -d geoserver lo levanta
# WASICHAI_GIS_GEOSERVER_ENABLED=true
WASICHAI_GIS_GEOSERVER_URL=http://localhost:8095/geoserver
WASICHAI_GIS_GEOSERVER_USERNAME=sgspe
WASICHAI_GIS_GEOSERVER_PASSWORD=sgspe-geoserver
# el datastore: cómo llega GeoServer a PostGIS por la red del compose, con el rol de solo lectura (security.md §10.2, regla 6)
WASICHAI_GIS_GEOSERVER_DATASTORE_HOST=postgis
WASICHAI_GIS_GEOSERVER_DATASTORE_PORT=5432
WASICHAI_GIS_GEOSERVER_DATASTORE_DATABASE=sgspe
WASICHAI_GIS_GEOSERVER_DATASTORE_USERNAME=sgspe_geoserver
WASICHAI_GIS_GEOSERVER_DATASTORE_PASSWORD=sgspe-geoserver-lectura
# puerto que publica compose.yml (debe coincidir con WASICHAI_GIS_GEOSERVER_URL)
SGSPE_GEOSERVER_PORT=8095

# --- Scripts del modelo (model/apply.py, model/apply_roles.py y model/publish_layers.py) ---
WASICHAI_CORE=http://localhost:8094
WASICHAI_EMAIL=admin@wasichai.local
WASICHAI_PASSWORD=admin

# --- Pruebas de integración contra la base externa del VPS (Docker remoto). El nombre debe terminar en _test ---
# WASICHAI_TEST_DB_HOST=localhost
# WASICHAI_TEST_DB_PORT=5435
# WASICHAI_TEST_DB_NAME=sgspe_test
# WASICHAI_TEST_DB_USERNAME=sgspe
# WASICHAI_TEST_DB_PASSWORD=sgspe
# el MinIO de compose.yml para FileStoreContractTest, por el túnel del puerto 9095 (en la CI lo levanta Testcontainers)
# SGSPE_TEST_S3_ENDPOINT=http://localhost:9095
# SGSPE_TEST_S3_ACCESS_KEY=sgspe
# SGSPE_TEST_S3_SECRET_KEY=sgspe-minio
# F8 (plan 8.2c): Gotenberg por el túnel (compose.yml publica SGSPE_GOTENBERG_PORT en 127.0.0.1)
SGSPE_GOTENBERG_PORT=8096
SGSPE_DELIVERABLE_GOTENBERG_URL=http://localhost:8096
